{
  "manifest_version": 3,
  "name": "Selective Translate — learn by reading",
  "short_name": "Selective Translate",
  "version": "0.1.0",
  "description": "Translate only the word or sentence you select — never the whole page. Save words and review them with spaced-repetition flashcards.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Selective Translate",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared/core.js", "src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "side_panel": {
    "default_path": "src/dictionary/dictionary.html"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "alarms", "sidePanel"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://libretranslate.com/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+T", "mac": "Alt+T" },
      "description": "Translate the selected text"
    }
  }
}
